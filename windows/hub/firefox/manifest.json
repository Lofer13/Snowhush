{
  "manifest_version": 2,
  "name": "Snowhush for Firefox",
  "version": "0.1.0",
  "description": "Lets the snow of Snowhush settle on the elements of the page you are looking at.",
  "browser_specific_settings": {
    "gecko": {
      "id": "snowhush-hub@local",
      "strict_min_version": "102.0"
    }
  },
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage"],
  "browser_action": {
    "default_title": "Snowhush",
    "default_popup": "popup.html"
  }
}
